# ---------- Option A: OpenAI ----------
OPENAI_API_KEY=sk-your-key
# Model for orchestration (planning; streams its decisions)
OPENAI_MODEL_ORCHESTRATOR=gpt-4o
# Faster model for the specialist agents (uses tool calling)
OPENAI_MODEL_AGENT=gpt-4o-mini
# OPENAI_ORG_ID=org-...
# OPENAI_BASE_URL=https://api.openai.com/v1    # change only for a proxy or compatible gateway

# ---------- Option B: Azure OpenAI (set these instead; they take priority) ----------
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_DEPLOYMENT_ORCHESTRATOR=your-gpt-4o-deployment
# AZURE_OPENAI_DEPLOYMENT_AGENT=your-gpt-4o-mini-deployment
# AZURE_OPENAI_API_VERSION=2024-10-21

# ---------- Protect the demo (strongly recommended when it is on the internet) ----------
DEMO_USER=demo
DEMO_PASSWORD=change-me

# ---------- Tuning (optional) ----------
PORT=8080
# TEMPERATURE=0.2          # set to empty (TEMPERATURE=) for models that don't accept temperature
# MAX_TOKENS_PARAM=max_completion_tokens   # use max_tokens for older Azure API versions
# MAX_TOKENS_ORCHESTRATOR=2500
# MAX_TOKENS_AGENT=1800
# RATE_LIMIT_PER_MINUTE=120
